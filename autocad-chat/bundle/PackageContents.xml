<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage
    SchemaVersion="1.0"
    AutodeskProduct="AutoCAD"
    ProductType="Application"
    Name="Claude for AutoCAD"
    Description="A chat panel that works on the open drawing through AutoCAD MCP Pro."
    AppVersion="1.0.0"
    FriendlyVersion="1.0.0"
    SupportedLocales="Enu"
    ProductCode="{8B6E0F7A-2D41-4C6B-9E1A-5F3C7A9D2E10}"
    UpgradeCode="{3C2A9E54-7B18-4F0D-A6E2-91D4B8C7F035}">

  <CompanyDetails Name="Claude for AutoCAD" />

  <!-- AutoCAD 2025 (R25.0) and 2026 (R25.1): both run .NET 8. -->
  <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0" SeriesMax="R25.1" />

  <Components Description="Claude chat panel">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0" SeriesMax="R25.1" />
    <ComponentEntry
        AppName="AutoCADChat"
        Version="1.0.0"
        ModuleName="./Contents/AutoCADChat.dll"
        AppDescription="Chat with Claude about the open drawing"
        LoadOnAutoCADStartup="True">
      <Commands GroupName="CLAUDE">
        <Command Global="CLAUDE" Local="CLAUDE" />
        <Command Global="CLAUDEOPEN" Local="CLAUDEOPEN" />
      </Commands>
    </ComponentEntry>
  </Components>
</ApplicationPackage>
