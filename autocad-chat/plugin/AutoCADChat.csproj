<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Claude panel for AutoCAD 2025 (and 2026): a .NET 8 AutoCAD plugin. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AutoCADChat</AssemblyName>
    <RootNamespace>AutoCADChat</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Claude for AutoCAD</Product>
    <Description>A chat panel inside AutoCAD that works on the open drawing through AutoCAD MCP Pro.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms by reference: the UI is built in code, so no XAML compiler is needed
         and the plugin builds on any OS. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- AutoCAD 2025 API (R25.0). Reference only: AutoCAD supplies these at run time. -->
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
