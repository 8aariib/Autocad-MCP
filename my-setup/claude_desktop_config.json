{
  "mcpServers": {
    "autocad": {
      "command": "uvx",
      "args": ["--from", "autocad-mcp-pro[com,pdf,office]==1.8.0", "autocad-mcp"],
      "env": {
        "AUTOCAD_MCP_BACKEND": "com",
        "CAD_LAUNCH": "never",
        "ALLOWED_PATHS": "C:\\Users\\YOUR_NAME\\Documents\\AutoCAD",
        "MAX_TOOL_COST": "destructive",
        "DANGEROUS_COMMANDS_ENABLED": "false",
        "DISCOVERY_MODE": "search"
      }
    }
  }
}
